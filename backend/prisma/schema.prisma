datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  password_hash String
  full_name     String?
  role          String   @default("DOCTOR") // "ADMIN", "RECEPTIONIST", "DOCTOR"
  created_at    DateTime @default(now())
  doctor        Doctor?  @relation("UserDoctor")

  @@map("users")
}

model Doctor {
  id                         String             @id @default(uuid())
  user_id                    String?            @unique  // FK to User account (optional for legacy doctors)
  full_name                  String
  profile_image_url          String?
  gender                     String?
  email                      String?
  phone_number               String?
  address                    String?
  specialization             String?            // Department: "Cardiology", "Neurology", etc.
  experience                 String?            // e.g. "5 years"
  education                  String?            // Qualification: "MBBS", "MD", etc.
  license_number             String?            // Required legal field
  status                     String             @default("Available")
  working_hours              String?            @default("9AM - 2PM")
  rating                     Float              @default(0.0)
  total_reviews              Int                @default(0)
  total_patients             Int                @default(0)
  surgeries                  Int                @default(0)
  patients_increase_percent  Float              @default(0.0)
  user                       User?              @relation("UserDoctor", fields: [user_id], references: [id], onDelete: SetNull)
  appointments               Appointment[]
  availability_slots         AvailabilitySlot[]
  patients                   Patient[]

  @@map("doctors")
}

model Patient {
  id                    String   @id @default(uuid())
  full_name             String
  avatar_url            String?
  email                 String?
  phone                 String?
  address               String?
  country               String?
  state                 String?
  city                  String?
  blood_type            String?  // Enum: A, B, AB, O, etc.
  allergies             String?
  status                String   @default("Under Treatment") // "Under Treatment", "Recovered"
  assigned_doctor_id    String?
  specialist_department String?  // e.g. "Cardiology"
  registered_at         DateTime @default(now())

  assigned_doctor       Doctor?       @relation(fields: [assigned_doctor_id], references: [id], onDelete: SetNull)
  appointments          Appointment[]

  @@map("patients")
}

model Appointment {
  id                String   @id @default(uuid())
  doctor_id         String
  patient_id        String?
  patient_name      String   // Fallback name if patient_id is null
  consultation_type String   // "Routine check up", etc.
  appointment_time  String   // "09:40 AM"
  appointment_date  DateTime @default(now())
  category          String   // "Check-up", "Urgent visit"
  status            String   // "Confirm", "Canceled", "Pending"
  created_at        DateTime @default(now())
  
  doctor            Doctor   @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  patient           Patient? @relation(fields: [patient_id], references: [id], onDelete: SetNull)

  @@map("appointments")
}

model AvailabilitySlot {
  id        String  @id @default(uuid())
  doctor_id String
  time_slot String  // "09:00 AM", etc.
  is_booked Boolean @default(false)
  doctor    Doctor  @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  @@map("availability_slots")
}

model Notification {
  id         String   @id @default(uuid())
  title      String
  message    String
  type       String   // "message", "alert", "document"
  created_at DateTime @default(now())
  is_read    Boolean  @default(false)

  @@map("notifications")
}

model Polyclinic {
  id   String @id // e.g. "general", "pediatrics", "cardiology", "dermatology"
  name String

  @@map("polyclinics")
}
